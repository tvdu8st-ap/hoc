# ==============================================================================
# HỆ THỐNG GÓC LẮNG NGHE – CÙNG EM TRƯỞNG THÀNH
# File Cấu Hình Môi Trường Mẫu (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHẾ ĐỘ CHẠY (DEVELOPMENT vs PRODUCTION)
# ------------------------------------------------------------------------------
# NODE_ENV:
# - 'development': Chế độ phát triển. KHÔNG CẦN CẤU HÌNH DATABASE_URL.
#                  Hệ thống tự động kích hoạt bộ nhớ tạm In-Memory để bạn xem và
#                  kiểm thử toàn bộ giao diện học sinh, tư vấn, admin.
#                  (Dữ liệu KHÔNG lưu vào database thực tế).
# - 'production':  Chế độ triển khai thực tế. BẮT BUỘC phải có DATABASE_URL hợp lệ.
#                  Nếu chưa cấu hình hoặc kết nối thất bại, server sẽ báo lỗi và dừng.
NODE_ENV="development"

# PORT: Cổng dịch vụ Node.js Express (mặc định: 3000)
PORT=3000

# APP_URL: URL ứng dụng (phục vụ CORS và điều hướng)
APP_URL="http://localhost:3000"

# SESSION_SECRET: Khóa HMAC-SHA256 ký token phiên nội bộ (tối thiểu 32 ký tự ngẫu nhiên)
SESSION_SECRET="dev-secret-key-change-to-strong-random-string-in-production-min-32-chars"

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (CHỈ BẮT BUỘC KHI CHẠY PRODUCTION)
# ------------------------------------------------------------------------------
# DATABASE_URL: Chuỗi kết nối chuẩn tới cơ sở dữ liệu PostgreSQL.
# Cú pháp: postgresql://[user]:[password]@[host]:[port]/[database]
# Ví dụ: postgresql://postgres:matkhau123@localhost:5432/goclangnghe
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goclangnghe"

# (Tùy chọn) Có thể cấu hình theo biến phân tách nếu dùng Cloud SQL hoặc container riêng:
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="your-strong-password"
SQL_DB_NAME="goclangnghe"

# ------------------------------------------------------------------------------
# 3. TRỢ LÝ AI BẠN ĐỒNG HÀNH (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Khóa API cho tính năng hỗ trợ tâm lý học đường (Gemini 3.8 Flash)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
